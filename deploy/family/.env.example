# Copy locally to .env and keep it OUT of Git / support messages.
# This host must have a DNS record pointing to its public address.
FAMILY_DOMAIN=family.example.org

# These values must be digests of distinct, cryptographically random
# 32-byte+ secrets. NEVER paste raw tokens into a public repo or exported game.
FAMILY_PARENT_UNLOCK_SHA256=REPLACE_WITH_64_HEX_SHA256
FAMILY_CHILD_A_TOKEN_SHA256=REPLACE_WITH_64_HEX_SHA256
FAMILY_CHILD_B_TOKEN_SHA256=REPLACE_WITH_64_HEX_SHA256
