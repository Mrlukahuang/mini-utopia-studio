# Adult-owned Mac only; copy to .env and chmod 600. No DNS domain.
# Set the MacBook's fixed RFC1918 home Wi-Fi IPv4.
FAMILY_LAN_IP=REPLACE_WITH_PRIVATE_LAN_IPV4

# Never commit any real digest or send original unlock secrets to GitHub/CI.
# Keep the adult raw unlock in your LOCAL password manager; child raw tokens
# are legacy server-only and are never sent to the browser.
FAMILY_PARENT_UNLOCK_SHA256=REPLACE_WITH_64_HEX_SHA256
FAMILY_CHILD_A_TOKEN_SHA256=REPLACE_WITH_64_HEX_SHA256
FAMILY_CHILD_B_TOKEN_SHA256=REPLACE_WITH_64_HEX_SHA256
