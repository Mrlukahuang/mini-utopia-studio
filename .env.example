OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_TEXT_MODEL=gpt-6-luna
GEMINI_API_KEY=
STUDIO_PIN=
CREATOR_PIN=

# Optional GPU Hero Asset Worker (Pixal3D / TripoSR)
HERO_ASSET_WORKER_URL=
HERO_ASSET_WORKER_TOKEN=
HERO_ASSET_MODEL=pixal3d
HERO_ASSET_TIMEOUT_SECONDS=900
HERO_ASSET_MAX_PER_WORLD=1

# Optional direct Hugging Face Pixal3D ZeroGPU provider.
# Keep HF_TOKEN only in local/Streamlit/GitHub secrets, never commit a real token.
HF_TOKEN=
HF_HERO_SPACE_ID=TencentARC/Pixal3D
HF_PIXAL3D_RESOLUTION=1024
HF_PIXAL3D_DECIMATION_TARGET=300000
HF_PIXAL3D_TEXTURE_SIZE=2048
HF_PIXAL3D_SEED=42
